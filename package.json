{
  "name": "dsh-markitdown",
  "version": "0.3.0",
  "description": "Microsoft MarkItDown integration for DeepSeek Harness: convert PDF, Office, HTML, images, audio and more to Markdown through model-facing tools, plus a bundled conversion skill.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markitdown",
    "markdown",
    "document-conversion",
    "pdf",
    "office"
  ],
  "license": "MIT",
  "author": {
    "name": "AlbertZJ",
    "url": "https://github.com/AlbertZJ"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertZJ/dsh-markitdown.git"
  },
  "homepage": "https://github.com/AlbertZJ/dsh-markitdown#readme",
  "bugs": {
    "url": "https://github.com/AlbertZJ/dsh-markitdown/issues"
  },
  "packageManager": "pnpm@11.28.5",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./*": "./lib/*.js",
    "./client": "./lib/client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "assets",
    "locale",
    "python",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node scripts/clean-build.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
